datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Semester {
  id            String   @id @default(uuid())
  name          String // e.g., "Fall 2026"
  code          String? // e.g., "FA26"
  startDate     DateTime
  endDate       DateTime
  status        String   @default("UPCOMING") // UPCOMING, ACTIVE, COMPLETED, ARCHIVED
  description   String?
  academicGoals String?
  color         String?  @default("#3b82f6")
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courses        Course[]
  documents      Document[]
  notes          Note[]
  assignments    Assignment[]
  exams          Exam[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]
  assessments    Assessment[]
  courseGrades   CourseGrade[]
  studyPlans     StudyPlan[]
  projects       Project[]
  classSessions  ClassSession[]
  feePlan        SemesterFeePlan?
  feeItems       FeeItem[]
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([isArchived])
  @@index([userId])
}

model Course {
  id               String   @id @default(uuid())
  semesterId       String
  semester         Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  code             String // e.g. "CSE443"
  title            String // e.g. "Information System Security"
  credits          Float    @default(3.0)
  section          String? // e.g. "01"
  teacherName      String?
  teacherEmail     String?
  roomNumber       String?
  description      String?
  syllabus         String?
  color            String   @default("#3b82f6")
  icon             String?  @default("book")
  classSchedule    String? // e.g. "Mon, Wed 10:00 - 11:30 AM"
  examSchedule     String?
  midtermPrepNotes String?
  finalPrepNotes   String?
  progress         Int      @default(0) // 0 to 100%
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documents      Document[]
  notes          Note[]
  assignments    Assignment[]
  exams          Exam[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]
  assessments    Assessment[]
  courseGrade    CourseGrade?
  studyPlans     StudyPlan[]
  projects       Project[]
  classSessions  ClassSession[]
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeItems       FeeItem[]

  @@index([semesterId])
  @@index([code])
  @@index([userId])
}

model Document {
  id               String    @id @default(uuid())
  semesterId       String?
  semester         Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  courseId         String?
  course           Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title            String
  originalFilename String
  storedFilename   String    @unique
  filePath         String
  mimeType         String
  fileSize         Int
  category         String    @default("Other Documents")
  // "Lecture Slides", "Class Notes", "Midterm Questions", "Final Questions", "Previous Year Questions",
  // "Assignments", "Lab Reports", "Research Papers", "Syllabus", "Other Documents"
  description      String?
  comments         String?
  isPdf            Boolean   @default(false)
  pageCount        Int       @default(1)
  lastOpenedPage   Int       @default(1)
  lastOpenedAt     DateTime?
  isScanned        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  visibility      String               @default("PRIVATE") // PRIVATE, PUBLIC, UNLISTED
  bookmarks       DocumentBookmark[]
  annotations     DocumentAnnotation[]
  tags            DocumentTag[]
  notes           Note[]
  examLinks       ExamDocument[]
  assignmentLinks AssignmentDocument[]
  studySessions   StudySession[]
  linkedNoteLinks NoteLink[]
  versions        DocumentVersion[]
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([semesterId])
  @@index([courseId])
  @@index([category])
  @@index([visibility])
  @@index([userId])
}

model DocumentBookmark {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int
  title      String
  color      String?  @default("#f59e0b")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([documentId, pageNumber, title])
  @@index([documentId])
}

model DocumentAnnotation {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber   Int
  type         String   @default("highlight") // highlight, note, underline, strike
  color        String   @default("#fde047") // yellow, green, blue, pink, orange
  selectedText String?
  comment      String?
  rectJson     String? // Bounding rect JSON: { x, y, width, height }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([documentId])
  @@index([pageNumber])
}

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  color     String?       @default("#6b7280")
  documents DocumentTag[]
}

model DocumentTag {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

model Note {
  id           String      @id @default(uuid())
  semesterId   String?
  semester     Semester?   @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  courseId     String?
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  documentId   String?
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  examId       String?
  exam         Exam?       @relation(fields: [examId], references: [id], onDelete: SetNull)
  folderId     String?
  folder       NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title        String
  content      String      @default("") // Derived rich-text HTML (export/search/share)
  contentJson  String? // Canonical versioned Lexical editor state (validated JSON)
  isPinned     Boolean     @default(false)
  isArchived   Boolean     @default(false)
  visibility   String      @default("PRIVATE") // PRIVATE, PUBLIC, UNLISTED
  tags         String? // JSON array string of tags
  version      Int         @default(1)
  reminderDate DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  revisions     NoteRevision[]
  outgoingLinks NoteLink[]     @relation("SourceNoteLinks")
  incomingLinks NoteLink[]     @relation("TargetNoteLinks")
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([semesterId])
  @@index([courseId])
  @@index([folderId])
  @@index([isPinned])
  @@index([isArchived])
  @@index([visibility])
  @@index([userId])
}

model Assignment {
  id                String    @id @default(uuid())
  semesterId        String
  semester          Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  deadline          DateTime
  priority          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status            String    @default("NOT_STARTED") // BACKLOG, TODO, NOT_STARTED, IN_PROGRESS, SUBMITTED, IN_REVIEW, COMPLETED, CANCELLED
  progress          Int       @default(0) // 0 to 100%
  estimatedHours    Float?
  submissionDate    DateTime?
  submissionLink    String?
  isSubmittedOnTime Boolean?
  personalNotes     String?
  visibility        String    @default("PRIVATE") // PRIVATE, PUBLIC, UNLISTED
  projectId         String?
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  checklist       TaskChecklistItem[]
  documents       AssignmentDocument[]
  notes           Note[]
  studyPlans      StudyPlan[]
  studySessions   StudySession[]
  linkedNoteLinks NoteLink[]

  @@index([semesterId])
  @@index([courseId])
  @@index([status])
  @@index([deadline])
  @@index([visibility])
  @@index([projectId])
  @@index([userId])
}

model AssignmentDocument {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  purpose      String     @default("SUPPORTING_MATERIAL") // INSTRUCTION, SUPPORTING_MATERIAL, SUBMISSION_DRAFT
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, documentId])
  @@index([assignmentId])
  @@index([documentId])
}

model Exam {
  id                String   @id @default(uuid())
  semesterId        String
  semester          Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  examType          String   @default("Midterm") // Quiz, Midterm, Final, Practical, Viva
  examDate          DateTime
  room              String?
  syllabus          String?
  personalNotes     String?
  preparationStatus String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, REVISION_READY, CONFIDENT
  prepPercentage    Int      @default(0) // 0 to 100%
  visibility        String   @default("PRIVATE") // PRIVATE, PUBLIC, UNLISTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  checklist       TaskChecklistItem[]
  questionPapers  ExamDocument[]
  notes           Note[]
  studyPlans      StudyPlan[]
  studySessions   StudySession[]
  linkedNoteLinks NoteLink[]
  userId          String?
  user            User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([semesterId])
  @@index([courseId])
  @@index([examDate])
  @@index([visibility])
  @@index([userId])
}

model ExamDocument {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  purpose    String   @default("QUESTION_PAPER") // QUESTION_PAPER, LECTURE_MATERIAL, SYLLABUS, CHEAT_SHEET
  createdAt  DateTime @default(now())

  @@unique([examId, documentId])
  @@index([examId])
  @@index([documentId])
}

model TaskChecklistItem {
  id           String      @id @default(uuid())
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  examId       String?
  exam         Exam?       @relation(fields: [examId], references: [id], onDelete: Cascade)
  text         String
  isCompleted  Boolean     @default(false)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([assignmentId])
  @@index([examId])
}

model CalendarEvent {
  id                    String    @id @default(uuid())
  semesterId            String?
  semester              Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  courseId              String?
  course                Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  startDate             DateTime
  endDate               DateTime
  isAllDay              Boolean   @default(false)
  category              String    @default("CLASS") // MIDTERM, FINAL, ASSIGNMENT, PROJECT, LAB, CLASS, STUDY_SESSION, REMINDER, PERSONAL
  priority              String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  isCompleted           Boolean   @default(false)
  location              String?
  notes                 String?
  reminderMinutesBefore Int?      @default(60)
  recurrenceRule        String? // e.g. "FREQ=WEEKLY;INTERVAL=1;COUNT=10"
  userId                String?
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  linkedNoteLinks NoteLink[]

  @@index([startDate])
  @@index([endDate])
  @@index([semesterId])
  @@index([courseId])
  @@index([category])
  @@index([userId])
}

model StudySession {
  id                    String      @id @default(uuid())
  semesterId            String?
  semester              Semester?   @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  courseId              String?
  course                Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  studyPlanId           String?
  studyPlan             StudyPlan?  @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)
  examId                String?
  exam                  Exam?       @relation(fields: [examId], references: [id], onDelete: SetNull)
  assignmentId          String?
  assignment            Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  documentId            String?
  document              Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title                 String
  topic                 String?
  scheduledDate         DateTime
  plannedStartTime      DateTime?
  plannedEndTime        DateTime?
  durationMinutes       Int         @default(60)
  actualDurationMinutes Int         @default(0)
  priority              String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status                String      @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, MISSED, CANCELLED
  pomodoroCount         Int         @default(0)
  sessionType           String      @default("STUDY") // STUDY, POMODORO, BREAK
  breakDurationMinutes  Int         @default(0)
  topics                String?
  isCompleted           Boolean     @default(false)
  notes                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([semesterId])
  @@index([courseId])
  @@index([studyPlanId])
  @@index([scheduledDate])
  @@index([status])
  @@index([userId])
}

model AppSetting {
  id                         String   @id @default("default")
  userId                     String?  @unique
  user                       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                      String   @default("light") // light, dark, system
  studentName                String   @default("Student")
  universityName             String?  @default("University")
  degree                     String?  @default("B.S. in Computer Science & Engineering")
  currentSemesterId          String?
  enableBrowserNotifications Boolean  @default(false)
  autoSaveDelayMs            Int      @default(1500)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// ==================== NEW EXTENSIONS ====================

// 1. User & Role-Based Authentication
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  name         String    @default("Student Owner")
  role         String    @default("STUDENT") // ADMIN, STUDENT, DEMO
  accountType  String    @default("REGULAR") // REGULAR, GOOGLE, DEMO
  status       String    @default("ACTIVE") // ACTIVE, DISABLED
  googleId     String?   @unique
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions               Session[]
  activityEvents         ActivityEvent[]
  semesters              Semester[]
  courses                Course[]
  documents              Document[]
  notes                  Note[]
  studyPlans             StudyPlan[]
  studySessions          StudySession[]
  assessments            Assessment[]
  assignments            Assignment[]
  calendarEvents         CalendarEvent[]
  projects               Project[]
  gradeScenarios         GradeScenario[]
  inAppNotifications     InAppNotification[]
  classSessions          ClassSession[]
  classPhotos            ClassPhoto[]
  degreePrograms         DegreeProgram[]
  exams                  Exam[]
  courseGrades           CourseGrade[]
  noteFolders            NoteFolder[]
  backupRecords          BackupRecord[]
  shareLinks             ShareLink[]
  setting                AppSetting?
  notificationPreference NotificationPreference?
  dashboardPreference    DashboardPreference?
  targetGpaGoal          TargetGpaGoal?
  studyGoal              StudyGoal?
  feePlans               SemesterFeePlan[]
  feeItems               FeeItem[]
  subscriptions          Subscription[]

  @@index([role])
  @@index([status])
  @@index([accountType])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionToken])
}

model ActivityEvent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType    String // SIGN_IN, SIGN_OUT, COURSE_CREATE, COURSE_UPDATE, ASSIGNMENT_CREATE, EXAM_CREATE, STUDY_SESSION_CREATE, DOCUMENT_UPLOAD, NOTE_CREATE, NOTE_UPDATE, PDF_VIEW, BACKUP_GENERATE, SHARE_LINK_CREATE, SHARE_LINK_REVOKE, PREFERENCES_UPDATE
  resourceType String? // DOCUMENT, NOTE, COURSE, ASSIGNMENT, EXAM, STUDY_SESSION, BACKUP, SHARE, SETTINGS, AUTH
  resourceId   String?
  isDemo       Boolean  @default(false)
  metadataJson String? // Strictly allowlisted non-sensitive metadata only (e.g. { category: "LECTURE_SLIDE" })
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([isDemo])
}

// 2. Notification Preferences
model NotificationPreference {
  id                         String   @id @default("default")
  userId                     String?  @unique
  user                       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail             String   @default("student@example.com")
  emailEnabled               Boolean  @default(true)
  notifyAssignments          Boolean  @default(true)
  notifyQuizzes              Boolean  @default(true)
  notifyMidterms             Boolean  @default(true)
  notifyFinals               Boolean  @default(true)
  notifyProjects             Boolean  @default(true)
  notifyCustomEvents         Boolean  @default(true)
  notifyStudySessions        Boolean  @default(true)
  enableBrowserNotifications Boolean  @default(false)
  assignmentIntervals        String   @default("[\"7d\",\"3d\",\"1d\",\"due\"]")
  quizIntervals              String   @default("[\"3d\",\"1d\",\"due\"]")
  midtermIntervals           String   @default("[\"7d\",\"3d\",\"1d\",\"due\"]")
  finalIntervals             String   @default("[\"7d\",\"3d\",\"1d\",\"due\"]")
  projectIntervals           String   @default("[\"7d\",\"3d\",\"1d\",\"due\"]")
  customEventIntervals       String   @default("[\"1d\",\"due\"]")
  studySessionIntervals      String   @default("[\"2h\",\"start\"]")
  timezone                   String   @default("Asia/Dhaka")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// 3. Automated Reminder Scheduler Queue
model NotificationJob {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique // e.g. "ASSIGNMENT:<id>:<triggerType>"
  targetType     String // "ASSIGNMENT", "EXAM", "CALENDAR_EVENT"
  targetId       String
  triggerType    String // "7d", "3d", "1d", "due", "CUSTOM"
  channel        String    @default("EMAIL") // "EMAIL", "IN_APP", "BOTH"
  scheduledFor   DateTime
  status         String    @default("PENDING") // "PENDING", "PROCESSING", "SENT", "FAILED", "SKIPPED"
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  nextRetryAt    DateTime?
  lockedAt       DateTime?
  lastError      String?
  payloadJson    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([targetType, targetId])
}

// 4. Notification & Email Delivery Audit Log
model NotificationLog {
  id               String    @id @default(uuid())
  jobId            String?
  notificationType String // "ASSIGNMENT", "QUIZ", "MIDTERM", "FINAL", "PROJECT", "CUSTOM_EVENT", "TEST_EMAIL"
  targetId         String?
  targetTitle      String?
  recipient        String
  subject          String
  scheduledTime    DateTime
  actualSendTime   DateTime?
  status           String    @default("Pending") // "Pending", "Sent", "Failed", "Skipped"
  retryCount       Int       @default(0)
  lastError        String?
  createdAt        DateTime  @default(now())

  @@index([status])
  @@index([notificationType])
  @@index([createdAt])
}

// 5. In-App Notification Center
model InAppNotification {
  id               String    @id @default(uuid())
  title            String
  message          String
  category         String // "ASSIGNMENT", "EXAM", "CALENDAR", "SYSTEM"
  targetType       String?
  targetId         String?
  linkUrl          String?
  notificationType String?
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead           Boolean   @default(false)
  scheduledFor     DateTime?
  createdAt        DateTime  @default(now())

  @@index([isRead])
  @@index([userId])
  @@index([createdAt])
}

// 6. Public & Unlisted Sharing System
model ShareLink {
  id                  String    @id @default(uuid())
  userId              String?
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token               String    @unique // Cryptographically secure token
  resourceType        String // "DOCUMENT", "NOTE", "COURSE", "ASSIGNMENT", "EXAM"
  resourceId          String
  visibility          String    @default("UNLISTED") // "PUBLIC", "UNLISTED", "PRIVATE"
  title               String?
  passwordHash        String? // bcrypt hash if password protected
  isPasswordProtected Boolean   @default(false)
  allowDownload       Boolean   @default(true)
  allowIndexing       Boolean   @default(false)
  viewMode            String    @default("PREVIEW") // "FULL_ORIGINAL", "PREVIEW", "METADATA_ONLY"
  expiresAt           DateTime?
  isRevoked           Boolean   @default(false)
  accessCount         Int       @default(0)
  lastAccessedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accessLogs ShareAccessLog[]

  @@index([resourceType, resourceId])
  @@index([token])
  @@index([visibility])
  @@index([isRevoked])
  @@index([userId])
}

model ShareAccessLog {
  id          String    @id @default(uuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  action      String    @default("VIEW") // "VIEW", "DOWNLOAD", "PASSWORD_VERIFY_SUCCESS", "PASSWORD_VERIFY_FAIL"
  createdAt   DateTime  @default(now())

  @@index([shareLinkId])
  @@index([createdAt])
}

// ==================== ADVANCED EXTENSIONS ====================

// 7. Dashboard Preferences (Feature 1)
model DashboardPreference {
  id                 String   @id @default("default")
  userId             String?  @unique
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetOrder        String   @default("[\"activeSemester\",\"statsOverview\",\"academicProgress\",\"upcomingDeadlines\",\"todaySessions\",\"weeklyProgress\",\"recentNotes\",\"recentDocuments\",\"calendarEvents\"]")
  hiddenWidgets      String   @default("[]") // JSON array string of widget IDs
  defaultView        String   @default("today") // "today", "week", "upcoming"
  selectedSemesterId String?
  selectedCourseId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// 8. Grade Management & Scale (Feature 3)
model GradeScale {
  id              String   @id @default("default")
  name            String   @default("Standard 4.0 Scale")
  minPassingGrade String   @default("D")
  scaleData       String   @default("[{\"letter\":\"A+\",\"points\":4.0,\"minMarks\":90},{\"letter\":\"A\",\"points\":3.75,\"minMarks\":85},{\"letter\":\"A-\",\"points\":3.5,\"minMarks\":80},{\"letter\":\"B+\",\"points\":3.25,\"minMarks\":75},{\"letter\":\"B\",\"points\":3.0,\"minMarks\":70},{\"letter\":\"B-\",\"points\":2.75,\"minMarks\":65},{\"letter\":\"C+\",\"points\":2.5,\"minMarks\":60},{\"letter\":\"C\",\"points\":2.25,\"minMarks\":55},{\"letter\":\"D\",\"points\":2.0,\"minMarks\":50},{\"letter\":\"F\",\"points\":0.0,\"minMarks\":0}]")
  isDefault       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Assessment {
  id               String    @id @default(uuid())
  semesterId       String
  semester         Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  category         String    @default("ASSIGNMENT") // ATTENDANCE, CLASS_TEST, QUIZ, ASSIGNMENT, MIDTERM, FINAL, LAB, PROJECT, OTHER
  maxMarks         Float     @default(100.0)
  obtainedMarks    Float?
  weightPercentage Float? // e.g. 20 for 20%
  assessmentDate   DateTime?
  notes            String?
  isIncluded       Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([semesterId])
  @@index([courseId])
  @@index([category])
  @@index([userId])
}

model CourseGrade {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String   @unique
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId  String
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  finalScore  Float? // Total calculated score (e.g. 88.5)
  gradeLetter String? // e.g. "A"
  gradePoint  Float? // e.g. 3.75
  isCompleted Boolean  @default(false)
  isRetake    Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([semesterId])
  @@index([userId])
}

model TargetGpaGoal {
  id         String   @id @default("default")
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCgpa Float    @default(3.8)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 9. Smart Study Planner (Feature 4)
model StudyPlan {
  id                    String      @id @default(uuid())
  semesterId            String
  semester              Semester    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseId              String?
  course                Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title                 String
  targetExamId          String?
  targetExam            Exam?       @relation(fields: [targetExamId], references: [id], onDelete: SetNull)
  targetAssignmentId    String?
  targetAssignment      Assignment? @relation(fields: [targetAssignmentId], references: [id], onDelete: SetNull)
  topics                String? // JSON string or newline list
  difficulty            Int         @default(3) // 1 to 5
  priority              String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  estimatedHours        Float       @default(10.0)
  availableHoursPerWeek Float?      @default(15.0)
  startDate             DateTime
  endDate               DateTime
  status                String      @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  sessions StudySession[]
  userId   String?
  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([semesterId])
  @@index([courseId])
  @@index([status])
  @@index([userId])
}

// 10. Knowledge Base & Note Organization (Feature 5)
model NoteFolder {
  id        String       @id @default(uuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?      @default("#6366f1")
  icon      String?      @default("folder")
  parentId  String?
  parent    NoteFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  NoteFolder[] @relation("FolderHierarchy")
  notes     Note[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([parentId])
  @@index([userId])
}

model NoteRevision {
  id            String   @id @default(uuid())
  noteId        String
  note          Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  version       Int
  title         String
  content       String
  contentJson   String? // Canonical versioned Lexical editor state at this revision
  createdReason String   @default("AUTOSAVE") // AUTOSAVE, MANUAL_SAVE, RESTORE
  createdAt     DateTime @default(now())

  @@index([noteId])
  @@index([createdAt])
}

model NoteLink {
  id                    String         @id @default(uuid())
  sourceNoteId          String
  sourceNote            Note           @relation("SourceNoteLinks", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNoteId          String?
  targetNote            Note?          @relation("TargetNoteLinks", fields: [targetNoteId], references: [id], onDelete: Cascade)
  targetDocumentId      String?
  targetDocument        Document?      @relation(fields: [targetDocumentId], references: [id], onDelete: Cascade)
  targetExamId          String?
  targetExam            Exam?          @relation(fields: [targetExamId], references: [id], onDelete: Cascade)
  targetAssignmentId    String?
  targetAssignment      Assignment?    @relation(fields: [targetAssignmentId], references: [id], onDelete: Cascade)
  targetCalendarEventId String?
  targetCalendarEvent   CalendarEvent? @relation(fields: [targetCalendarEventId], references: [id], onDelete: Cascade)
  linkType              String // "NOTE", "DOCUMENT", "EXAM", "ASSIGNMENT", "CALENDAR"
  anchorText            String?
  pageNumber            Int?
  createdAt             DateTime       @default(now())

  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([targetDocumentId])
}

// 11. Backup Records (Feature 7)
model BackupRecord {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String   @unique
  filePath     String
  sizeBytes    Int
  checksum     String // SHA-256
  itemCount    Int      @default(0)
  manifestJson String?
  status       String   @default("SUCCESS") // SUCCESS, FAILED
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// 12. Document Version Control (Feature 5)
model DocumentVersion {
  id                String   @id @default(uuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber     Int
  originalFilename  String
  storedFilename    String   @unique
  filePath          String
  mimeType          String
  fileSize          Int
  checksum          String // SHA-256
  changeDescription String?
  createdAt         DateTime @default(now())

  @@index([documentId])
  @@index([versionNumber])
}

// 13. Projects & Milestones Workspace (Feature 2)
model Project {
  id             String    @id @default(uuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId     String?
  semester       Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  courseId       String?
  course         Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  objectives     String?
  deliverables   String?
  importantLinks String?
  deadline       DateTime?
  status         String    @default("IN_PROGRESS") // PLANNING, IN_PROGRESS, IN_REVIEW, COMPLETED, ON_HOLD
  progress       Int       @default(0) // 0 to 100%
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  milestones ProjectMilestone[]
  tasks      Assignment[]

  @@index([userId])
  @@index([semesterId])
  @@index([courseId])
  @@index([status])
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
}

// 14. Academic Performance Scenarios (Feature 4)
model GradeScenario {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetCgpa   Float?
  scenarioData String // JSON string of hypothetical courses, credits & expected grades
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// 15. Admin Action Audit Trail (Feature 7)
model AdminAuditEvent {
  id          String   @id @default(uuid())
  actorId     String
  actorEmail  String
  action      String // e.g. "USER_STATUS_CHANGE", "ROLE_CHANGE", "SETTINGS_UPDATE"
  targetType  String?
  targetId    String?
  detailsJson String? // Safe metadata without sensitive secrets
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// 16. Study Goals (Feature 3)
model StudyGoal {
  id                String   @id @default("default")
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyTargetHours Float    @default(20.0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 17. Smart Class Photo Journal (Board Photo Archive)
model ClassSession {
  id          String       @id @default(uuid())
  semesterId  String
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionDate DateTime
  topic       String
  teacherName String?
  roomNumber  String?
  description String?
  photos      ClassPhoto[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([semesterId])
  @@index([courseId])
  @@index([sessionDate])
  @@index([userId])
}

model ClassPhoto {
  id               String       @id @default(uuid())
  sessionId        String
  session          ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename String
  storedFilename   String       @unique
  filePath         String
  mimeType         String
  fileSize         Int
  width            Int?
  height           Int?
  caption          String?
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}

// 18. University Curriculum & Degree Progress Planner
model DegreeProgram {
  id                    String    @id @default(uuid())
  userId                String?
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityName        String    @default("My University")
  programName           String    @default("Undergraduate Degree")
  department            String?
  degreeDurationYears   Float?    @default(4.0)
  totalCreditsRequired  Float     @default(120.0)
  requiredSemesters     Int?      @default(8)
  curriculumYear        String? // e.g. "2024-2025"
  startSemesterName     String? // e.g. "Fall 2023"
  targetGraduationDate  DateTime?
  minCreditsPerSemester Float?    @default(12.0)
  maxCreditsPerSemester Float?    @default(18.0)
  isConfigured          Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  curriculumCourses CurriculumCourse[]
  plannedCourses    PlannedCourse[]

  @@index([userId])
}

model CurriculumCourse {
  id                  String        @id @default(uuid())
  degreeProgramId     String
  degreeProgram       DegreeProgram @relation(fields: [degreeProgramId], references: [id], onDelete: Cascade)
  code                String // e.g. "CSE115"
  title               String // e.g. "Programming Language I"
  credits             Float         @default(3.0)
  category            String        @default("CORE") // CORE, ELECTIVE, GENERAL_EDUCATION, BASIC_SCIENCE, LAB, CAPSTONE
  isRequired          Boolean       @default(true)
  recommendedSemester Int? // e.g. 1 to 12
  minPassingGrade     String?       @default("D")
  description         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  prerequisites   CoursePrerequisite[] @relation("CoursePrerequisites")
  prerequisiteFor CoursePrerequisite[] @relation("PrerequisiteCourse")
  plannedIn       PlannedCourse[]

  @@index([degreeProgramId])
  @@index([code])
  @@index([category])
}

model CoursePrerequisite {
  id                   String           @id @default(uuid())
  courseId             String
  course               CurriculumCourse @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourseId String
  prerequisiteCourse   CurriculumCourse @relation("PrerequisiteCourse", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)
  minGradeLetter       String?          @default("D")
  createdAt            DateTime         @default(now())

  @@unique([courseId, prerequisiteCourseId])
  @@index([courseId])
  @@index([prerequisiteCourseId])
}

model PlannedCourse {
  id                 String           @id @default(uuid())
  degreeProgramId    String
  degreeProgram      DegreeProgram    @relation(fields: [degreeProgramId], references: [id], onDelete: Cascade)
  curriculumCourseId String
  curriculumCourse   CurriculumCourse @relation(fields: [curriculumCourseId], references: [id], onDelete: Cascade)
  targetSemesterName String // e.g. "Spring 2027"
  status             String           @default("PLANNED") // PLANNED, REGISTERED, DROPPED
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([degreeProgramId, curriculumCourseId, targetSemesterName])
  @@index([degreeProgramId])
  @@index([targetSemesterName])
}

// Per-semester tuition settings: cost = credits x perCreditFee, minus a waiver/scholarship percentage.
model SemesterFeePlan {
  id            String   @id @default(uuid())
  semesterId    String   @unique
  semester      Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  currency      String   @default("BDT")
  perCreditFee  Float    @default(0)
  waiverPercent Float    @default(0)
  tuitionPaid   Float    @default(0)
  notes         String?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// One payable line on top of tuition: admission, mid-term, final, lab, library, etc.
model FeeItem {
  id         String    @id @default(uuid())
  semesterId String
  semester   Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  category   String    @default("OTHER") // REGISTRATION, MID_EXAM, FINAL_EXAM, LAB, LIBRARY, ACTIVITY, TRANSPORT, HOSTEL, OTHER
  label      String
  amount     Float     @default(0)
  paidAmount Float     @default(0)
  dueDate    DateTime?
  paidAt     DateTime?
  notes      String?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([semesterId])
  @@index([courseId])
  @@index([userId])
}

// SaaS pricing: plans the owner publishes. Students buy one by paying outside the app and submitting
// the transaction id for the owner to approve.
model Plan {
  id             String         @id @default(uuid())
  name           String
  description    String?
  durationMonths Int            @default(1)
  isSemester     Boolean        @default(false)
  price          Float          @default(0)
  currency       String         @default("BDT")
  features       String         @default("[]") // JSON array of strings
  isActive       Boolean        @default(true)
  isPopular      Boolean        @default(false)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String?
  plan           Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  // Snapshot of what the student agreed to, so later plan edits never change past purchases.
  planName       String
  amount         Float
  currency       String    @default("BDT")
  durationMonths Int
  status         String    @default("PENDING") // PENDING, ACTIVE, REJECTED, CANCELLED
  paymentMethod  String    @default("OTHER") // BKASH, NAGAD, ROCKET, BANK, CARD, OTHER
  transactionId  String
  payerNumber    String?
  paidAt         DateTime?
  studentNote    String?
  startsAt       DateTime?
  endsAt         DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([transactionId])
}

// Key/value platform settings the owner edits (payment instructions, etc.).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
