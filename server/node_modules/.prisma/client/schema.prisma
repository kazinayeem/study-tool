datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Semester {
  id            String   @id @default(uuid())
  name          String // e.g., "Fall 2026"
  code          String? // e.g., "FA26"
  startDate     DateTime
  endDate       DateTime
  status        String   @default("UPCOMING") // UPCOMING, ACTIVE, COMPLETED, ARCHIVED
  description   String?
  academicGoals String?
  color         String?  @default("#3b82f6")
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courses        Course[]
  documents      Document[]
  notes          Note[]
  assignments    Assignment[]
  exams          Exam[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]

  @@index([status])
  @@index([isArchived])
}

model Course {
  id               String   @id @default(uuid())
  semesterId       String
  semester         Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  code             String // e.g. "CSE443"
  title            String // e.g. "Information System Security"
  credits          Float    @default(3.0)
  section          String? // e.g. "01"
  teacherName      String?
  teacherEmail     String?
  roomNumber       String?
  description      String?
  syllabus         String?
  color            String   @default("#3b82f6")
  icon             String?  @default("book")
  classSchedule    String? // e.g. "Mon, Wed 10:00 - 11:30 AM"
  examSchedule     String?
  midtermPrepNotes String?
  finalPrepNotes   String?
  progress         Int      @default(0) // 0 to 100%
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  documents      Document[]
  notes          Note[]
  assignments    Assignment[]
  exams          Exam[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]

  @@index([semesterId])
  @@index([code])
}

model Document {
  id               String    @id @default(uuid())
  semesterId       String?
  semester         Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  courseId         String?
  course           Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title            String
  originalFilename String
  storedFilename   String    @unique
  filePath         String
  mimeType         String
  fileSize         Int
  category         String    @default("Other Documents")
  // "Lecture Slides", "Class Notes", "Midterm Questions", "Final Questions", "Previous Year Questions",
  // "Assignments", "Lab Reports", "Research Papers", "Syllabus", "Other Documents"
  description      String?
  comments         String?
  isPdf            Boolean   @default(false)
  pageCount        Int       @default(1)
  lastOpenedPage   Int       @default(1)
  lastOpenedAt     DateTime?
  isScanned        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bookmarks       DocumentBookmark[]
  annotations     DocumentAnnotation[]
  tags            DocumentTag[]
  notes           Note[]
  examLinks       ExamDocument[]
  assignmentLinks AssignmentDocument[]

  @@index([semesterId])
  @@index([courseId])
  @@index([category])
}

model DocumentBookmark {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int
  title      String
  color      String?  @default("#f59e0b")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([documentId, pageNumber, title])
  @@index([documentId])
}

model DocumentAnnotation {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber   Int
  type         String   @default("highlight") // highlight, note, underline, strike
  color        String   @default("#fde047") // yellow, green, blue, pink, orange
  selectedText String?
  comment      String?
  rectJson     String? // Bounding rect JSON: { x, y, width, height }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([documentId])
  @@index([pageNumber])
}

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  color     String?       @default("#6b7280")
  documents DocumentTag[]
}

model DocumentTag {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([documentId, tagId])
  @@index([documentId])
  @@index([tagId])
}

model Note {
  id           String      @id @default(uuid())
  semesterId   String?
  semester     Semester?   @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  courseId     String?
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  documentId   String?
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  examId       String?
  exam         Exam?       @relation(fields: [examId], references: [id], onDelete: SetNull)
  title        String
  content      String      @default("") // Rich text HTML / markdown
  isPinned     Boolean     @default(false)
  tags         String? // JSON array string of tags
  version      Int         @default(1)
  reminderDate DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([semesterId])
  @@index([courseId])
  @@index([isPinned])
}

model Assignment {
  id            String   @id @default(uuid())
  semesterId    String
  semester      Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  deadline      DateTime
  priority      String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status        String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, SUBMITTED, COMPLETED
  personalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checklist TaskChecklistItem[]
  documents AssignmentDocument[]
  notes     Note[]

  @@index([semesterId])
  @@index([courseId])
  @@index([status])
  @@index([deadline])
}

model AssignmentDocument {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  purpose      String     @default("SUPPORTING_MATERIAL") // INSTRUCTION, SUPPORTING_MATERIAL, SUBMISSION_DRAFT
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, documentId])
  @@index([assignmentId])
  @@index([documentId])
}

model Exam {
  id                String   @id @default(uuid())
  semesterId        String
  semester          Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  examType          String   @default("Midterm") // Quiz, Midterm, Final, Practical, Viva
  examDate          DateTime
  room              String?
  syllabus          String?
  personalNotes     String?
  preparationStatus String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, REVISION_READY, CONFIDENT
  prepPercentage    Int      @default(0) // 0 to 100%
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  checklist      TaskChecklistItem[]
  questionPapers ExamDocument[]
  notes          Note[]

  @@index([semesterId])
  @@index([courseId])
  @@index([examDate])
}

model ExamDocument {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  purpose    String   @default("QUESTION_PAPER") // QUESTION_PAPER, LECTURE_MATERIAL, SYLLABUS, CHEAT_SHEET
  createdAt  DateTime @default(now())

  @@unique([examId, documentId])
  @@index([examId])
  @@index([documentId])
}

model TaskChecklistItem {
  id           String      @id @default(uuid())
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  examId       String?
  exam         Exam?       @relation(fields: [examId], references: [id], onDelete: Cascade)
  text         String
  isCompleted  Boolean     @default(false)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([assignmentId])
  @@index([examId])
}

model CalendarEvent {
  id                    String    @id @default(uuid())
  semesterId            String?
  semester              Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  courseId              String?
  course                Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  startDate             DateTime
  endDate               DateTime
  isAllDay              Boolean   @default(false)
  category              String    @default("CLASS") // MIDTERM, FINAL, ASSIGNMENT, PROJECT, LAB, CLASS, STUDY_SESSION, REMINDER, PERSONAL
  priority              String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  isCompleted           Boolean   @default(false)
  location              String?
  notes                 String?
  reminderMinutesBefore Int?      @default(60)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([semesterId])
  @@index([courseId])
  @@index([category])
}

model StudySession {
  id              String    @id @default(uuid())
  semesterId      String?
  semester        Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  courseId        String?
  course          Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title           String
  scheduledDate   DateTime
  durationMinutes Int       @default(60)
  topics          String?
  isCompleted     Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([semesterId])
  @@index([courseId])
  @@index([scheduledDate])
}

model AppSetting {
  id                         String   @id @default("default")
  theme                      String   @default("light") // light, dark, system
  studentName                String   @default("Student")
  universityName             String?  @default("University")
  degree                     String?  @default("B.S. in Computer Science & Engineering")
  currentSemesterId          String?
  enableBrowserNotifications Boolean  @default(false)
  autoSaveDelayMs            Int      @default(1500)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}
