# ==============================================================================
# ScholarFlow Environment Configuration
# ==============================================================================

# Server & Network Ports
PORT=5001
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5001
NODE_ENV=development

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# Security Secrets
JWT_SECRET="scholarflow-super-secret-key-2026"
SESSION_SECRET="scholarflow-session-signing-secret-2026"

# ==============================================================================
# Google OAuth 2.0 Credentials
# ==============================================================================
# Instructions for Google Cloud Console:
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/
# 2. Configure OAuth Consent Screen (User Type: External, Add scopes: 'openid', 'email', 'profile')
# 3. Create "OAuth Client ID" of type "Web application"
# 4. Set Authorized JavaScript origins:
#    - http://localhost:5173
#    - http://localhost:5001
# 5. Set Authorized redirect URIs:
#    - http://localhost:5001/auth/google/callback
#    - http://localhost:5001/api/auth/google/callback
# 6. Copy your Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# ==============================================================================
# SMTP Email Notification Configuration
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@scholarflow.local
SMTP_FROM_NAME="ScholarFlow Notifications"
EMAIL_NOTIFICATIONS_ENABLED=true
NOTIFICATION_TIMEZONE="Asia/Dhaka"
